diff --git a/include/linux/capability.h b/include/linux/capability.h
index 55dfbfafb43b..a68476387994 100644
--- a/include/linux/capability.h
+++ b/include/linux/capability.h
@@ -255,6 +255,11 @@ static inline bool perfmon_capable(void)
 	return capable(CAP_PERFMON) || capable(CAP_SYS_ADMIN);
 }
 
+static inline bool bpf_capable(void)
+{
+	return capable(CAP_BPF) || capable(CAP_SYS_ADMIN);
+}
+
 /* audit system wants to get cap info from files as well */
 extern int get_vfs_caps_from_disk(const struct dentry *dentry, struct cpu_vfs_cap_data *cpu_caps);
 
diff --git a/include/uapi/linux/capability.h b/include/uapi/linux/capability.h
index 4eeb11bc4438..89c253c56bcc 100644
--- a/include/uapi/linux/capability.h
+++ b/include/uapi/linux/capability.h
@@ -260,6 +260,7 @@ struct vfs_cap_data {
 /* Allow setting encryption key on loopback filesystem */
 /* Allow setting zone reclaim policy */
 
+/* Allow everything under CAP_BPF and CAP_PERFMON for compatibility. */
 #define CAP_SYS_ADMIN        21
 
 /* Allow use of reboot() */
@@ -355,7 +356,14 @@ struct vfs_cap_data {
 /* Allow privileged performance monitoring and observability. */
 #define CAP_PERFMON		38
 
-#define CAP_LAST_CAP         CAP_PERFMON
+/*
+ * Allow privileged BPF operations. Loading networking programs also requires
+ * CAP_NET_ADMIN; tracing programs and pointer disclosure require CAP_PERFMON.
+ * CAP_SYS_ADMIN remains a backwards-compatible fallback for both capabilities.
+ */
+#define CAP_BPF			39
+
+#define CAP_LAST_CAP         CAP_BPF
 
 #define cap_valid(x) ((x) >= 0 && (x) <= CAP_LAST_CAP)
 
